{
  "name": "hrm-erp",
  "version": "0.1.0",
  "private": true,
  "description": "ERP HRM + Payroll System - Industry 4.0 (Pakistan)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hrm/web",
    "dev:web": "npm run dev -w @hrm/web",
    "dev:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-dev-server.ps1",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev-server.ps1",
    "dev:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dev-autostart.ps1",
    "build:web": "pnpm --filter @hrm/web build",
    "dev:api": "dotnet run --project apps/api/Hrm.Api.csproj",
    "build:api": "dotnet build apps/api/Hrm.Api.csproj",
    "setup:agent": "powershell -ExecutionPolicy Bypass -File apps/agent/setup-agent.ps1",
    "dev:agent": "powershell -ExecutionPolicy Bypass -File apps/agent/run-agent.ps1",
    "launcher:agent": "powershell -ExecutionPolicy Bypass -File apps/agent/agent-launcher.ps1",
    "build:agent": "dotnet build apps/agent/Hrm.ZktAgent.csproj -c Release -r win-x86",
    "reset:db": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/run-reset-database.ps1",
    "reset:remote": "node scripts/reset-remote-database.mjs && node scripts/reseed-via-rest.mjs"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
